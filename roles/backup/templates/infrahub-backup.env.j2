{#- Every value is double-quoted with \ " $ ` backslash-escaped (backslash first):
    systemd EnvironmentFile= and POSIX sh `. file` (the run-now wrapper) both read
    it back as the exact value (research R11). Newline/CR is rejected in
    tasks/docker/validate.yml. -#}
{#- backup_infrahub_environment is combined last, so its AWS_* keys override the
    S3 credential variables. -#}
{%- set entries = backup_infrahub_s3_credentials | combine(backup_infrahub_environment) -%}
# Managed by Ansible (opsmill.infrahub.backup) — contains secrets
{% for key, value in entries | dictsort %}
{{ key }}="{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('$', '\\$') | replace('`', '\\`') }}"
{% endfor %}
