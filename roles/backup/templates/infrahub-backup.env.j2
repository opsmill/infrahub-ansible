# Managed by Ansible (opsmill.infrahub.backup) — contains secrets
{% if backup_infrahub_s3_access_key_id is defined %}
AWS_ACCESS_KEY_ID={{ backup_infrahub_s3_access_key_id }}
{% endif %}
{% if backup_infrahub_s3_secret_access_key is defined %}
AWS_SECRET_ACCESS_KEY={{ backup_infrahub_s3_secret_access_key }}
{% endif %}
{% for key, value in backup_infrahub_environment | dictsort %}
{{ key }}={{ value }}
{% endfor %}
