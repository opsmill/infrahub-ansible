# Infrahub configuration
{% for k, v in install_infrahub_config.items() %}
{{ k }}={{ v }}
{% endfor %}
{% if install_infrahub_version is defined %}
VERSION={{ install_infrahub_version }}
{% endif %}
{% if install_infrahub_mode == 'cluster' %}
WEB_CONCURRENCY={{ install_infrahub_web_concurrency }}
{% endif %}
